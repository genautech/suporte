rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helpers de autenticação
    function hasAuthEmail() {
      return request.auth != null && request.auth.token.email != null;
    }

    function userRoleDocExists() {
      return hasAuthEmail() &&
             exists(/databases/$(database)/documents/userRoles/$(request.auth.token.email));
    }

    function userRoleField(fieldName) {
      return get(/databases/$(database)/documents/userRoles/$(request.auth.token.email)).data[fieldName];
    }

    // Função helper para verificar se é admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        (hasAuthEmail() && request.auth.token.email == 'admin@yoobe.co') ||
        (userRoleDocExists() && userRoleField('role') == 'admin')
      );
    }
    
    // Função helper para verificar se é gestor
    function isManager() {
      return userRoleDocExists() && userRoleField('role') == 'manager';
    }
    
    // Função helper para verificar se é gestor de uma empresa específica
    function isManagerOfCompany(companyId) {
      return isManager() &&
             userRoleField('companyId') == companyId;
    }

    function managerCompanyUpdateAllowed(companyId) {
      return isManagerOfCompany(companyId) &&
             request.resource.data.keys().hasOnly(['managerName', 'managerEmail', 'updatedAt']);
    }

    function managerCanGrantRole(email) {
      return isManager() &&
        request.resource.data.email is string &&
        request.resource.data.email.lower() == email.lower() &&
        request.resource.data.role == 'manager' &&
        request.resource.data.companyId != null &&
        request.resource.data.companyId == userRoleField('companyId') &&
        request.resource.data.keys().hasOnly(['email', 'role', 'companyId', 'createdAt', 'updatedAt']);
    }

    function managerCanRevokeRole(email) {
      return isManager() &&
        resource.data != null &&
        resource.data.companyId == userRoleField('companyId') &&
        resource.data.email != null &&
        resource.data.email.lower() == email.lower() &&
        request.resource.data.keys().hasOnly(['role', 'companyId', 'updatedAt']) &&
        request.resource.data.role == 'client' &&
        (request.resource.data.companyId == null);
    }
    
    // Regras padrão - permitir leitura/escrita autenticada
    // Ajuste estas regras conforme necessário para sua aplicação
    
    // Tickets - usuários podem ler/escrever seus próprios tickets, gestores podem ler tickets da sua empresa
    match /tickets/{ticketId} {
      allow read: if request.auth != null && 
                     (resource.data.userId == request.auth.token.email || 
                      resource.data.email == request.auth.token.email ||
                      isAdmin() ||
                      (isManager() && resource.data.companyId != null && 
                       isManagerOfCompany(resource.data.companyId)));
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && 
                              (resource.data.userId == request.auth.token.email || 
                               resource.data.email == request.auth.token.email ||
                               isAdmin());
    }
    
    // FAQ - todos podem ler, apenas admins podem escrever
    // Clientes veem apenas FAQ da sua empresa + generalista
    match /faq/{faqId} {
      allow read: if true; // Todos podem ler, filtro por companyId é feito no código
      allow write: if isAdmin();
    }

    // Respostas padrão - usadas pelo chatbot e painel admin
    match /defaultResponses/{responseId} {
      // Qualquer usuário autenticado pode ler (client, gestor ou admin)
      allow read: if request.auth != null;

      // Apenas admins ou gestores da empresa relacionada podem criar
      allow create: if isAdmin() ||
        (
          isManager() &&
          request.resource.data.companyId != null &&
          isManagerOfCompany(request.resource.data.companyId)
        );

      // Apenas admins ou gestores da própria empresa podem atualizar/desativar
      allow update, delete: if isAdmin() ||
        (
          isManager() &&
          resource.data.companyId != null &&
          isManagerOfCompany(resource.data.companyId)
        );
    }
    
    // Knowledge Base - todos podem ler, apenas admins podem escrever
    // Clientes veem apenas KB da sua empresa + generalista
    match /knowledgeBase/{kbId} {
      allow read: if true; // Todos podem ler, filtro por companyId é feito no código
      allow write: if isAdmin();
    }
    
    // Companies - permitir leitura pública (dados não sensíveis: nome, domínios, keywords, greeting)
    // Necessário para verificação durante login de gestores e identificação de empresa
    // Apenas admins podem escrever
    match /companies/{companyId} {
      // Permitir leitura pública (dados não sensíveis)
      allow read: if true;
      // Apenas admins podem criar/deletar
      allow write: if isAdmin();
      // Gestor pode atualizar apenas os campos de contato
      allow update: if isAdmin() || managerCompanyUpdateAllowed(companyId);
    }

    // Support notices - comunicados exibidos na home (antes do login) e na área do cliente
    // Conteúdo não sensível, então leitura pública é permitida; escrita restrita a admins
    match /supportNotices/{noticeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // User Roles - permitir leitura pública para verificação de role (necessário para login)
    // Admins podem ler/escrever, qualquer usuário autenticado pode ler seu próprio documento
    // Leitura pública permitida apenas para verificação de role antes do login
    match /userRoles/{email} {
      allow read: if true; // Permitir leitura pública para verificação de role (dados não sensíveis: apenas role e companyId)
      allow create: if isAdmin() || managerCanGrantRole(email);
      allow update: if isAdmin() || managerCanGrantRole(email) || managerCanRevokeRole(email);
      allow delete: if isAdmin();
    }
    
    // Conversations - usuários podem ler/escrever suas próprias conversas, gestores podem ler conversas da sua empresa
    match /conversations/{conversationId} {
      allow read: if request.auth != null && 
                     (resource.data.userId == request.auth.token.email || 
                      isAdmin() ||
                      (isManager() && resource.data.companyId != null && 
                       isManagerOfCompany(resource.data.companyId)) ||
                      (isManager() && resource.data.assignedCompanyId != null && 
                       isManagerOfCompany(resource.data.assignedCompanyId)));
      allow write: if request.auth != null && 
                      (resource.data.userId == request.auth.token.email || 
                       isAdmin());
      allow create: if request.auth != null;
    }
    
    // Auth Codes - permitir criação sem autenticação (para gerar código antes do login)
    // Mas validar que o email está presente e corresponde ao email do código
    match /authCodes/{codeId} {
      // Permitir criar código sem autenticação, mas validar que tem email
      allow create: if request.resource.data.email != null && 
                       request.resource.data.code != null &&
                       request.resource.data.expiresAt != null;
      
      // Permitir ler códigos não usados sem autenticação (para invalidar códigos existentes)
      // OU se autenticado E o código for do próprio email
      allow read: if (resource.data.used == false) ||
                     (request.auth != null && 
                      (resource.data.email == request.auth.token.email || 
                       isAdmin()));
      
      // Permitir atualizar códigos não usados sem autenticação (para invalidar)
      // Mas apenas para marcar como usado (used: true)
      // OU se autenticado E o código for do próprio email
      allow update: if (resource.data.used == false && 
                        request.resource.data.used == true &&
                        request.resource.data.email == resource.data.email) ||
                       (request.auth != null && 
                        (resource.data.email == request.auth.token.email || 
                         isAdmin()));
      
      // Não permitir delete (códigos são marcados como used ao invés de deletados)
      allow delete: if false;
    }
    
    // API Configs - usuários autenticados podem ler (para buscar storeId para pedidos)
    // Apenas admins podem escrever
    match /apiConfigs/{configId} {
      // Permitir leitura para usuários autenticados (necessário para buscar storeId para pedidos)
      allow read: if request.auth != null;
      // Apenas admins podem escrever
      allow write: if isAdmin();
    }
    
    // Orders - usuários podem ler seus próprios pedidos
    match /orders/{orderId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // Support Users - permitir criação sem autenticação (para registrar login)
    // Mas apenas para o próprio email
    match /supportUsers/{email} {
      // Permitir criar apenas se o ID do documento (email) corresponder ao email no documento
      // Normalizar emails para comparação case-insensitive
      allow create: if email.lower() == request.resource.data.email.lower() &&
                       request.resource.data.email != null;
      
      // Permitir ler apenas se autenticado E for o próprio email OU admin OU gestor da empresa do usuário
      // Normalizar emails para comparação case-insensitive
      allow read: if request.auth != null && 
                     (email.lower() == request.auth.token.email.lower() || 
                      isAdmin() ||
                      (isManager() && resource.data.assignedCompanyId != null && 
                       isManagerOfCompany(resource.data.assignedCompanyId)) ||
                      (isManager() && resource.data.autoDetectedCompanyId != null && 
                       isManagerOfCompany(resource.data.autoDetectedCompanyId)));
      
      // Permitir atualizar apenas se autenticado E for o próprio email OU admin OU gestor da empresa do usuário
      // Normalizar emails para comparação case-insensitive
      allow update: if request.auth != null && 
                       (email.lower() == request.auth.token.email.lower() || 
                        isAdmin() ||
                        (isManager() && resource.data.assignedCompanyId != null && 
                         isManagerOfCompany(resource.data.assignedCompanyId)) ||
                        (isManager() && resource.data.autoDetectedCompanyId != null && 
                         isManagerOfCompany(resource.data.autoDetectedCompanyId)));
      
      // Não permitir delete
      allow delete: if false;
    }

    // Perfis do gestor - apenas gestores da própria empresa ou admins podem ler/escrever
    match /managerProfiles/{companyId} {
      allow read: if isAdmin() || (isManager() && isManagerOfCompany(companyId));
      allow create, update: if isAdmin() || (isManager() && isManagerOfCompany(companyId));
      allow delete: if isAdmin();
    }

    // Chamados do gestor - gestores podem criar e ler seus chamados, admins podem atualizar status
    match /managerEscalations/{escalationId} {
      allow read: if isAdmin() ||
        (isManager() && resource.data.companyId != null && isManagerOfCompany(resource.data.companyId));
      allow create: if isManager() &&
        request.resource.data.companyId != null &&
        isManagerOfCompany(request.resource.data.companyId);
      allow update, delete: if isAdmin();
    }

    // Notificações dedicadas ao gestor - apenas gestores da empresa e admins
    match /managerNotifications/{notificationId} {
      allow read: if isAdmin() ||
        (isManager() && resource.data.companyId != null && isManagerOfCompany(resource.data.companyId));
      allow create: if isAdmin() ||
        (isManager() &&
         request.resource.data.companyId != null &&
         isManagerOfCompany(request.resource.data.companyId));
      allow update, delete: if isAdmin();
    }

    // Cache de pedidos por empresa
    match /companyOrdersCache/{companyId} {
      allow read: if isAdmin() || (isManager() && isManagerOfCompany(companyId));
      allow create, update: if isAdmin() || (isManager() && isManagerOfCompany(companyId));
      allow delete: if isAdmin();
    }
    
    // Default: negar acesso
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

